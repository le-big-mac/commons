@Pqr.zeroAt_p_qsq_of_card : ∀ {M : ℕ} [inst : NeZero M] (p q : ℕ),
  Nat.Prime p →
    Nat.Prime q →
      p ≠ q →
        M = p ^ 2 * q ^ 2 →
          ∀ (A : Finset (ZMod M)),
            A.card = p * q → Pqr.ZeroAt A p → Pqr.ZeroAt A (p ^ 2 * q ^ 2) → Pqr.ZeroAt A (p * q ^ 2)
