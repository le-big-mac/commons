The statements as Lean has them:
@gBeyond : {p q n : ℕ} → Pnq.Tree p q n → ℕ → Finset ℕ
@balanced_base : ∀ {p q : ℕ},
  2 ≤ p →
    2 ≤ q →
      p.Coprime q →
        ∀ {n : ℕ} (t : Pnq.Tree p q n) (a0 : ℕ),
          F t 0 →
            (∀ (ℓ : ℕ), 1 ≤ ℓ → ℓ < a0 → F t ℓ) →
              1 ≤ a0 → a0 ≤ n → ¬F t a0 → q * p ^ (e t + (gBeyond t a0).card) ≤ size t
@balanced_plus : ∀ {p q : ℕ},
  2 ≤ p →
    2 ≤ q →
      p.Coprime q →
        ∀ {n : ℕ} (t : Pnq.Tree p q n) (a0 : ℕ),
          F t 0 →
            (∀ (ℓ : ℕ), 1 ≤ ℓ → ℓ < a0 → F t ℓ) →
              1 ≤ a0 →
                a0 ≤ n →
                  ¬F t a0 →
                    (gBeyond t a0).Nonempty →
                      (∀ ℓ < a0, ¬E t ℓ) →
                        (¬E t a0 ∨ p = 2 ∧ ∀ (b : ℕ), a0 < b → (∀ g ∈ gBeyond t a0, b < g) → E t b → F t b) →
                          q * p ^ e t * (p ^ (gBeyond t a0).card + 1) ≤ size t
def Pnq.gBeyond : {p q n : ℕ} → Pnq.Tree p q n → ℕ → Finset ℕ :=
fun {p q n} t a0 => {ℓ ∈ fSet t \ eSet t | a0 < ℓ}
balanced_base_zmod : ∀ (p q n : ℕ) [inst : Fact (Nat.Prime p)] [inst_1 : Fact (Nat.Prime q)],
  p ≠ q →
    ∀ (A : Finset (ZMod (p ^ n * q))) (a0 : ℕ),
      Pqr.ZeroAt A q →
        (∀ (ℓ : ℕ), 1 ≤ ℓ → ℓ < a0 → Pqr.ZeroAt A (p ^ ℓ * q)) →
          1 ≤ a0 → a0 ≤ n → ¬Pqr.ZeroAt A (p ^ a0 * q) → q * p ^ ((levelsE A).card + (levelsBeyond A a0).card) ≤ A.card
balanced_plus_zmod : ∀ (p q n : ℕ) [inst : Fact (Nat.Prime p)] [inst_1 : Fact (Nat.Prime q)],
  p ≠ q →
    ∀ (A : Finset (ZMod (p ^ n * q))) (a0 : ℕ),
      Pqr.ZeroAt A q →
        (∀ (ℓ : ℕ), 1 ≤ ℓ → ℓ < a0 → Pqr.ZeroAt A (p ^ ℓ * q)) →
          1 ≤ a0 →
            a0 ≤ n →
              ¬Pqr.ZeroAt A (p ^ a0 * q) →
                (levelsBeyond A a0).Nonempty →
                  (∀ (ℓ : ℕ), 1 ≤ ℓ → ℓ < a0 → ¬Pqr.ZeroAt A (p ^ ℓ)) →
                    (¬Pqr.ZeroAt A (p ^ a0) ∨
                        p = 2 ∧
                          ∀ (b : ℕ),
                            a0 < b →
                              b ≤ n →
                                (∀ g ∈ levelsBeyond A a0, b < g) → Pqr.ZeroAt A (p ^ b) → Pqr.ZeroAt A (p ^ b * q)) →
                      q * p ^ (levelsE A).card * (p ^ (levelsBeyond A a0).card + 1) ≤ A.card

