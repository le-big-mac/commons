def IsLeast.{u_1} : {α : Type u_1} → [LE α] → Set α → α → Prop :=
fun {α} [LE α] s a => a ∈ s ∧ a ∈ lowerBounds s
def lowerBounds.{u_1} : {α : Type u_1} → [LE α] → Set α → Set α :=
fun {α} [LE α] s => {x | ∀ ⦃a : α⦄, a ∈ s → x ≤ a}
def Nat.divisors : ℕ → Finset ℕ :=
fun n => {d ∈ Finset.Ico 1 (n + 1) | d ∣ n}
def Polynomial.cyclotomic.{u_1} : ℕ → (R : Type u_1) → [inst : Ring R] → Polynomial R :=
fun n R [Ring R] => if h : n = 0 then 1 else Polynomial.map (Int.castRingHom R) ⋯.choose
def ZMod : ℕ → Type :=
fun x =>
  match x with
  | 0 => ℤ
  | n.succ => Fin (n + 1)
def ZMod.val : {n : ℕ} → ZMod n → ℕ :=
fun x =>
  match (motive := (x : ℕ) → ZMod x → ℕ) x with
  | 0 => Int.natAbs
  | n.succ => Fin.val
