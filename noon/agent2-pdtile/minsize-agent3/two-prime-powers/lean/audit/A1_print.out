@Pnq.Upset.lower_bound : ∀ {p q n m : Nat} [inst : Fact (Nat.Prime p)] [inst_1 : Fact (Nat.Prime q)],
  @Ne Nat p q →
    ∀ (D : Finset Nat),
      Pnq.Upset.IsUpSet
          (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat)
