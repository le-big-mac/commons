                            (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) q m)) →
                      @Ne Nat d (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))) →
                        Iff
                          (@Dvd.dvd (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                            (@semigroupDvd (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                              (@SemigroupWithZero.toSemigroup (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                                (@NonUnitalSemiring.toSemigroupWithZero
                                  (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                                  (@AddMonoidAlgebra.nonUnitalSemiring Int Nat (@Ring.toSemiring Int Int.instRing)
                                    Nat.instAddSemigroup))))
                            (@Polynomial.cyclotomic d Int Int.instRing)
                            (@Pnq.maskW
                              (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat)
                                (@HPow.hPow Nat Nat Nat
                                  (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) p n)
                                (@HPow.hPow Nat Nat Nat
                                  (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) q m))
                              (@Pnq.Upset.instNeZeroPowMulPow p q n m inst inst_1) w))
                          (@Membership.mem Nat (Finset Nat)
                            (@SetLike.instMembership (Finset Nat) Nat (@Finset.instSetLike Nat)) D d))))
          (∑
            c ∈
