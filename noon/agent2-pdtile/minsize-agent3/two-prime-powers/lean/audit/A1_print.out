def Pnq.Upset.IsUpSet : ℕ → Finset ℕ → Prop :=
fun M D => (∀ d ∈ D, d ∣ M ∧ d ≠ 1) ∧ ∀ d ∈ D, ∀ (e : ℕ), d ∣ e → e ∣ M → e ∈ D
def Pnq.Upset.corners : ℕ → Finset ℕ → Finset ℕ :=
fun M D => {c ∈ M.divisors \ D | ∀ e ∈ M.divisors \ D, c ∣ e → e = c}
theorem Pnq.Upset.instNeZeroPowMulPow : ∀ {p q n m : ℕ} [Fact (Nat.Prime p)] [Fact (Nat.Prime q)],
  NeZero (p ^ n * q ^ m) :=
fun {p q n m} [Fact (Nat.Prime p)] [Fact (Nat.Prime q)] =>
  { out := Nat.mul_ne_zero (pow_ne_zero n (Nat.Prime.ne_zero Fact.out)) (pow_ne_zero m (Nat.Prime.ne_zero Fact.out)) }
def Pnq.maskW : {M : ℕ} → [NeZero M] → (ZMod M → ℕ) → Polynomial ℤ :=
fun {M} [NeZero M] w => ∑ a, Polynomial.C ↑(w a) * Polynomial.X ^ a.val
def Pnq.Upset.IsUpSet : Nat → Finset Nat → Prop :=
fun (M : Nat) (D : Finset Nat) =>
  And
    (∀ (d : Nat),
      @Membership.mem Nat (Finset Nat) (@SetLike.instMembership (Finset Nat) Nat (@Finset.instSetLike Nat)) D d →
        And (@Dvd.dvd Nat Nat.instDvd d M) (@Ne Nat d (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))))
    (∀ (d : Nat),
      @Membership.mem Nat (Finset Nat) (@SetLike.instMembership (Finset Nat) Nat (@Finset.instSetLike Nat)) D d →
        ∀ (e : Nat),
          @Dvd.dvd Nat Nat.instDvd d e →
            @Dvd.dvd Nat Nat.instDvd e M →
              @Membership.mem Nat (Finset Nat) (@SetLike.instMembership (Finset Nat) Nat (@Finset.instSetLike Nat)) D e)
def Pnq.Upset.corners : Nat → Finset Nat → Finset Nat :=
fun (M : Nat) (D : Finset Nat) =>
  {c ∈ @sdiff (Finset Nat) (@Finset.instSDiff Nat instDecidableEqNat) M.divisors D |
    ∀ (e : Nat),
      @Membership.mem Nat (Finset Nat) (@SetLike.instMembership (Finset Nat) Nat (@Finset.instSetLike Nat))
          (@sdiff (Finset Nat) (@Finset.instSDiff Nat instDecidableEqNat) M.divisors D) e →
        @Dvd.dvd Nat Nat.instDvd c e → @Eq Nat e c}
def Pnq.maskW : {M : Nat} →
  [@NeZero Nat (@MulZeroClass.toZero Nat Nat.instMulZeroClass) M] → (ZMod M → Nat) → @Polynomial Int Int.instSemiring :=
fun {M : Nat} [@NeZero Nat (@MulZeroClass.toZero Nat Nat.instMulZeroClass) M] (w : ZMod M → Nat) =>
  ∑ a : ZMod M,
    @HMul.hMul (@Polynomial Int Int.instSemiring) (@Polynomial Int Int.instSemiring) (@Polynomial Int Int.instSemiring)
      (@instHMul (@Polynomial Int Int.instSemiring) (@AddMonoidAlgebra.instMul Int Nat Int.instSemiring instAddNat))
      (@DFunLike.coe
        (@RingHom Int (@Polynomial Int Int.instSemiring) (@Semiring.toNonAssocSemiring Int Int.instSemiring)
          (@AddMonoidAlgebra.nonAssocSemiring Int Nat Int.instSemiring
            (@AddMonoid.toAddZeroClass Nat Nat.instAddMonoid)))
        Int (fun (x : Int) => @Polynomial Int Int.instSemiring)
        (@RingHom.instFunLike Int (@Polynomial Int Int.instSemiring) (@Semiring.toNonAssocSemiring Int Int.instSemiring)
          (@AddMonoidAlgebra.nonAssocSemiring Int Nat Int.instSemiring
            (@AddMonoid.toAddZeroClass Nat Nat.instAddMonoid)))
        (@Polynomial.C Int Int.instSemiring) (@Nat.cast Int instNatCastInt (w a)))
      (@HPow.hPow (@Polynomial Int Int.instSemiring) Nat (@Polynomial Int Int.instSemiring)
        (@instHPow (@Polynomial Int Int.instSemiring) Nat
          (@NPow.toPow (@Polynomial Int Int.instSemiring)
            (@Monoid.toNPow (@Polynomial Int Int.instSemiring)
              (@Semiring.toMonoid (@Polynomial Int Int.instSemiring)
                (@AddMonoidAlgebra.semiring Int Nat Int.instSemiring Nat.instAddMonoid)))))
        (@Polynomial.X Int Int.instSemiring) (@ZMod.val M a))
@Pnq.Upset.instNeZeroPowMulPow : ∀ {p q n m : Nat} [Fact (Nat.Prime p)] [Fact (Nat.Prime q)],
  @NeZero Nat (@MulZeroClass.toZero Nat Nat.instMulZeroClass)
    (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat)
      (@HPow.hPow Nat Nat Nat (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) p n)
      (@HPow.hPow Nat Nat Nat (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) q m))
@Pnq.Upset.structure_iff : ∀ {p q n m : Nat} [inst : Fact (Nat.Prime p)] [inst_1 : Fact (Nat.Prime q)],
  @Ne Nat p q →
    ∀ (D : Finset Nat),
      Pnq.Upset.IsUpSet
          (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat)
            (@HPow.hPow Nat Nat Nat (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) p n)
            (@HPow.hPow Nat Nat Nat (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) q m))
          D →
        ∀
          (w :
            ZMod
                (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat)
                  (@HPow.hPow Nat Nat Nat (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) p n)
                  (@HPow.hPow Nat Nat Nat (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) q
                    m)) →
              Nat),
          Iff
            (∀ (d : Nat),
              @Membership.mem Nat (Finset Nat) (@SetLike.instMembership (Finset Nat) Nat (@Finset.instSetLike Nat)) D
                  d →
                @Dvd.dvd (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                  (@semigroupDvd (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                    (@SemigroupWithZero.toSemigroup (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                      (@NonUnitalSemiring.toSemigroupWithZero (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                        (@AddMonoidAlgebra.nonUnitalSemiring Int Nat (@Ring.toSemiring Int Int.instRing)
                          Nat.instAddSemigroup))))
                  (@Polynomial.cyclotomic d Int Int.instRing)
                  (@Pnq.maskW
                    (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat)
                      (@HPow.hPow Nat Nat Nat (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid)))
                        p n)
                      (@HPow.hPow Nat Nat Nat (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid)))
                        q m))
                    (@Pnq.Upset.instNeZeroPowMulPow p q n m inst inst_1) w))
            (∃ (g :
              Nat →
                ZMod
                    (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat)
