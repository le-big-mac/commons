Pnq.Lift.minsize_unbalanced_mul : ∀ (p q n s : ℕ) [inst : Fact (Nat.Prime p)] [inst_1 : Fact (Nat.Prime q)]
  [inst_2 : NeZero s],
  p ≠ q →
    ∀ (Es Fs : Finset ℕ),
      Es ⊆ Finset.Icc 1 n →
        Fs ⊆ Finset.Icc 1 n →
          IsLeast
            {t |
              ∃ w,
                ∑ a, w a = t ∧
                  ¬Polynomial.cyclotomic q ℤ ∣ Pnq.maskW w ∧
                    (∀ ℓ ∈ Finset.Icc 1 n, Polynomial.cyclotomic (p ^ ℓ) ℤ ∣ Pnq.maskW w ↔ ℓ ∈ Es) ∧
                      (∀ ℓ ∈ Finset.Icc 1 n, Polynomial.cyclotomic (p ^ ℓ * q) ℤ ∣ Pnq.maskW w ↔ ℓ ∈ Fs) ∧
                        ∀ (d : ℕ), d ∣ p ^ n * q * s → ¬d ∣ p ^ n * q → ¬Polynomial.cyclotomic d ℤ ∣ Pnq.maskW w}
