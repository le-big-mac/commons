def Pnq.Lift.reduce : {N r : ℕ} → [NeZero N] → [Fact (Nat.Prime r)] → (ZMod (N * r) → ℕ) → ZMod N → ℕ :=
fun {N r} [NeZero N] [Fact (Nat.Prime r)] w' x => ∑ y, if (ZMod.castHom ⋯ (ZMod N)) y = x then w' y else 0
def Pnq.maskW : {M : ℕ} → [NeZero M] → (ZMod M → ℕ) → Polynomial ℤ :=
fun {M} [NeZero M] w => ∑ a, Polynomial.C ↑(w a) * Polynomial.X ^ a.val
def Pnq.minU : ℕ → ℕ → Finset ℕ → Finset ℕ → ℕ :=
fun p q Es Fs => if Fs ⊆ Es then p ^ Es.card else p ^ Es.card * (p ^ (Fs \ Es).card + q)
def Pnq.minB : ℕ → ℕ → Finset ℕ → Finset ℕ → ℕ → ℕ :=
fun p q Es Fs a0 => q * p ^ Es.card * (p ^ (Pnq.gOf Es Fs a0).card + Pnq.xOf p Es Fs a0)
def Pnq.xOf : ℕ → Finset ℕ → Finset ℕ → ℕ → ℕ :=
fun p Es Fs a0 =>
  if
      Pnq.gOf Es Fs a0 = ∅ ∨
        (∃ ℓ ∈ Es, ℓ < a0) ∨
          a0 ∈ Es ∧ 3 ≤ p ∨ a0 ∈ Es ∧ p = 2 ∧ ∃ b ∈ Es \ Fs, a0 < b ∧ ∀ g ∈ Pnq.gOf Es Fs a0, b < g then
    0
  else 1
def Pnq.gOf : Finset ℕ → Finset ℕ → ℕ → Finset ℕ :=
fun Es Fs a0 => {ℓ ∈ Fs \ Es | a0 < ℓ}
