            ∃ w',
              ∑ y, w' y = t ∧
                0 < t ∧ ∀ (d : ℕ), d ∣ p ^ n * q * s → d ≠ 1 → (Polynomial.cyclotomic d ℤ ∣ Pnq.maskW w' ↔ d ∈ P)} =
          {t |
            ∃ w,
              ∑ x, w x = t ∧
