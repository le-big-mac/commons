Pnq.Lift.minsize_balanced_mul : ∀ (p q n s : ℕ) [inst : Fact (Nat.Prime p)] [inst_1 : Fact (Nat.Prime q)]
  [inst_2 : NeZero s],
  p ≠ q →
    ∀ (Es Fs : Finset ℕ),
      Es ⊆ Finset.Icc 1 n →
        Fs ⊆ Finset.Icc 1 n →
          ∀ (a0 : ℕ),
            1 ≤ a0 →
              a0 ≤ n →
                (∀ (ℓ : ℕ), 1 ≤ ℓ → ℓ < a0 → ℓ ∈ Fs) →
                  a0 ∉ Fs →
                    IsLeast
                      {t |
                        ∃ w,
                          ∑ a, w a = t ∧
                            Polynomial.cyclotomic q ℤ ∣ Pnq.maskW w ∧
