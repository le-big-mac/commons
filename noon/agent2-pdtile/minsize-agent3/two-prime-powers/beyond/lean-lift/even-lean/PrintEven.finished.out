sum_half_pow_mu_lt : ∀ (T : Finset Nat),
  (∀ (t : Nat),
      @Membership.mem Nat (Finset Nat) (@SetLike.instMembership (Finset Nat) Nat (@Finset.instSetLike Nat)) T t →
        And (Not (@Dvd.dvd Nat Nat.instDvd (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))) t))
          (And (Not (@Dvd.dvd Nat Nat.instDvd (@OfNat.ofNat Nat (nat_lit 3) (instOfNatNat (nat_lit 3))) t))
            (@LT.lt Nat instLTNat (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))) t))) →
    @LT.lt Rat Rat.instLT
      (∑ t ∈ T,
        @HPow.hPow Rat Nat Rat (@instHPow Rat Nat Rat.instPowNat)
          (@HDiv.hDiv Rat Rat Rat (@instHDiv Rat Rat.instDiv)
            (@OfNat.ofNat Rat (nat_lit 1) (@Rat.instOfNat (nat_lit 1)))
            (@OfNat.ofNat Rat (nat_lit 2) (@Rat.instOfNat (nat_lit 2))))
          (μ t))
      (@HDiv.hDiv Rat Rat Rat (@instHDiv Rat Rat.instDiv) (@OfNat.ofNat Rat (nat_lit 1) (@Rat.instOfNat (nat_lit 1)))
        (@OfNat.ofNat Rat (nat_lit 8) (@Rat.instOfNat (nat_lit 8))))
