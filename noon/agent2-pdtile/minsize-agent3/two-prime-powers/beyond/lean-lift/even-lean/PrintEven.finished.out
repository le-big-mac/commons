@bad3_of_not_live : ∀ {ι : Type u_1} [inst : Fintype ι] (e : ι → Nat) (ε : ι → Bool) {p : Nat},
  Nat.Prime p →
    @Ne Nat p (@OfNat.ofNat Nat (nat_lit 3) (instOfNatNat (nat_lit 3))) →
