                          d) →
                      ∀ (c t t' : Nat),
                        @LT.lt Nat instLTNat t p →
                          @LT.lt Nat instLTNat t' p →
                            @Eq F3
                              (@classSum3 ι inst e ε η
                                (@HPow.hPow Nat Nat Nat
                                  (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) p i)
                                (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat)
                                  (@HMod.hMod Nat Nat Nat (@instHMod Nat Nat.instMod) c
                                    (@HPow.hPow Nat Nat Nat
                                      (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) p
                                      (@HSub.hSub Nat Nat Nat (@instHSub Nat instSubNat) i
                                        (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))))
                                  (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat) t
                                    (@HPow.hPow Nat Nat Nat
                                      (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) p
                                      (@HSub.hSub Nat Nat Nat (@instHSub Nat instSubNat) i
                                        (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))))))
                              (@classSum3 ι inst e ε η
                                (@HPow.hPow Nat Nat Nat
                                  (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) p i)
                                (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat)
                                  (@HMod.hMod Nat Nat Nat (@instHMod Nat Nat.instMod) c
                                    (@HPow.hPow Nat Nat Nat
                                      (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) p
