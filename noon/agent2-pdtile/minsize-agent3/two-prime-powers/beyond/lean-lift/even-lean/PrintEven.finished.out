@[reducible] def Pnq.F3 : Type :=
AlgebraicClosure (ZMod 3)
def Pnq.val3.{u_1} : {ι : Type u_1} → [Fintype ι] → (ι → ℕ) → (ι → Bool) → F3 → F3 :=
fun {ι} [Fintype ι] e ε ζ => ∑ k, ↑(sg (ε k)) * ζ ^ e k
def Pnq.Bad3.{u_1} : {ι : Type u_1} → [Fintype ι] → (ι → ℕ) → (ι → Bool) → ℕ → Prop :=
fun {ι} [Fintype ι] e ε d => ∀ (ζ : F3), IsPrimitiveRoot ζ d → val3 e ε ζ = 0
def Pnq.bad3Set.{u_1} : {ι : Type u_1} → [Fintype ι] → (ι → ℕ) → ℕ → Finset (ι → Bool) :=
fun {ι} [Fintype ι] e d => {ε | Bad3 e ε d}
def Pnq.classSum3.{u_1} : {ι : Type u_1} → [Fintype ι] → (ι → ℕ) → (ι → Bool) → F3 → ℕ → ℕ → F3 :=
fun {ι} [Fintype ι] e ε η M r => ∑ k, if e k % M = r then ↑(sg (ε k)) * η ^ e k else 0
def Pnq.csum.{u_1, u_2} : {ι : Type u_1} →
  [Fintype ι] → {V : Type u_2} → [AddCommGroup V] → (ι → ℕ) → (ι → V) → (ι → Bool) → ℕ → ℕ → V :=
fun {ι} [Fintype ι] {V} [AddCommGroup V] pos val ε M r => ∑ k, if pos k % M = r then sg (ε k) • val k else 0
def Pnq.levelBad.{u_1, u_2} : {ι : Type u_1} →
  [Fintype ι] → {V : Type u_2} → [AddCommGroup V] → (ι → ℕ) → (ι → V) → (ι → Bool) → ℕ → Prop :=
fun {ι} [Fintype ι] {V} [AddCommGroup V] pos val ε x =>
  match x with
  | 0 => ∑ k, sg (ε k) • val k = 0
  | j.succ => ∀ r < 2 ^ j, csum pos val ε (2 ^ (j + 1)) r = csum pos val ε (2 ^ (j + 1)) (r + 2 ^ j)
def Pnq.ExceptionalPair : {n : ℕ} → (ZMod n → ℕ) → Prop :=
fun {n} w => ∃ a b, w = Pi.single a 1 + Pi.single b 1 ∧ Even (addOrderOf (a - b))
@card_exists_levelBad_le : ∀ {ι : Type u_1} [inst : Fintype ι] {V : Type u_2} [inst_1 : AddCommGroup V] (pos : ι → Nat)
  (val : ι → V) (K : Nat),
  @LE.le Nat instLENat
    (@Finset.card (ι → Bool) {ε | ∃ j, And (@LE.le Nat instLENat j K) (@levelBad ι inst V inst_1 pos val ε j)})
    (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat) (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))
      (@Finset.card (ι → Bool)
        {ε | @levelBad ι inst V inst_1 pos val ε (@OfNat.ofNat Nat (nat_lit 0) (instOfNatNat (nat_lit 0)))}))
@bad3_of_badAt : ∀ {ι : Type u_1} [inst : Fintype ι] (e : ι → Nat) (ε : ι → Bool) (i : Nat) {d : Nat},
  Not (@Dvd.dvd Nat Nat.instDvd (@OfNat.ofNat Nat (nat_lit 3) (instOfNatNat (nat_lit 3))) d) →
    @BadAt ι inst e ε
        (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat)
          (@HPow.hPow Nat Nat Nat (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid)))
            (@OfNat.ofNat Nat (nat_lit 3) (instOfNatNat (nat_lit 3))) i)
          d) →
      @Bad3 ι inst e ε d
@classSum3_eq_of_bad3 : ∀ {ι : Type u_1} [inst : Fintype ι] (e : ι → Nat) (ε : ι → Bool) {p : Nat},
  Nat.Prime p →
    @Ne Nat p (@OfNat.ofNat Nat (nat_lit 3) (instOfNatNat (nat_lit 3))) →
      ∀ {i : Nat},
