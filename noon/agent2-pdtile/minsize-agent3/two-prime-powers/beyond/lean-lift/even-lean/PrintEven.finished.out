        ∀ (e : ι → Nat), ∃ ε, ∀ (d : Nat), @Dvd.dvd Nat Nat.instDvd d n → Not (@BadAt ι inst e ε d)
exists_signs_all : ∀ (n : Nat) [inst : @NeZero Nat (@MulZeroClass.toZero Nat Nat.instMulZeroClass) n]
  (w : ZMod n → Nat),
  (∃ x, @Ne Nat (w x) (@OfNat.ofNat Nat (nat_lit 0) (instOfNatNat (nat_lit 0)))) →
    Not (@ExceptionalPair n w) →
      ∃ u v,
        And (∀ (x : ZMod n), @Eq Nat (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) (u x) (v x)) (w x))
          (∀ (d : Nat),
            @Dvd.dvd Nat Nat.instDvd d n →
              Not
                (@Dvd.dvd (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                  (@semigroupDvd (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                    (@SemigroupWithZero.toSemigroup (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                      (@NonUnitalSemiring.toSemigroupWithZero (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                        (@AddMonoidAlgebra.nonUnitalSemiring Int Nat (@Ring.toSemiring Int Int.instRing)
                          Nat.instAddSemigroup))))
                  (@Polynomial.cyclotomic d Int Int.instRing)
                  (@HSub.hSub (@Polynomial Int Int.instSemiring) (@Polynomial Int Int.instSemiring)
                    (@Polynomial Int Int.instSemiring)
                    (@instHSub (@Polynomial Int Int.instSemiring)
                      (@SubNegMonoid.toSub (@Polynomial Int Int.instSemiring)
                        (@AddGroup.toSubNegMonoid (@Polynomial Int Int.instSemiring)
                          (@AddGroupWithOne.toAddGroup (@Polynomial Int Int.instSemiring)
                            (@Ring.toAddGroupWithOne (@Polynomial Int Int.instSemiring)
                              (@AddMonoidAlgebra.ring Int Nat Int.instRing Nat.instAddMonoid))))))
                    (@maskW n inst u) (@maskW n inst v))))
not_exists_signs_of_exceptionalPair : ∀ (n : Nat) [inst : @NeZero Nat (@MulZeroClass.toZero Nat Nat.instMulZeroClass) n]
  (w : ZMod n → Nat),
  @ExceptionalPair n w →
    Not
      (∃ u v,
        And (∀ (x : ZMod n), @Eq Nat (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) (u x) (v x)) (w x))
          (∀ (d : Nat),
            @Dvd.dvd Nat Nat.instDvd d n →
              Not
                (@Dvd.dvd (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                  (@semigroupDvd (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                    (@SemigroupWithZero.toSemigroup (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                      (@NonUnitalSemiring.toSemigroupWithZero (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                        (@AddMonoidAlgebra.nonUnitalSemiring Int Nat (@Ring.toSemiring Int Int.instRing)
                          Nat.instAddSemigroup))))
                  (@Polynomial.cyclotomic d Int Int.instRing)
                  (@HSub.hSub (@Polynomial Int Int.instSemiring) (@Polynomial Int Int.instSemiring)
                    (@Polynomial Int Int.instSemiring)
                    (@instHSub (@Polynomial Int Int.instSemiring)
                      (@SubNegMonoid.toSub (@Polynomial Int Int.instSemiring)
                        (@AddGroup.toSubNegMonoid (@Polynomial Int Int.instSemiring)
                          (@AddGroupWithOne.toAddGroup (@Polynomial Int Int.instSemiring)
                            (@Ring.toAddGroupWithOne (@Polynomial Int Int.instSemiring)
                              (@AddMonoidAlgebra.ring Int Nat Int.instRing Nat.instAddMonoid))))))
                    (@maskW n inst u) (@maskW n inst v)))))
