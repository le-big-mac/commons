                ∀ {η : F3},
                  @IsPrimitiveRoot F3
                      (@CommRing.toCommMonoid F3
                        (@AlgebraicClosure.instCommRing (ZMod (@OfNat.ofNat Nat (nat_lit 3) (instOfNatNat (nat_lit 3))))
                          (@ZMod.instField (@OfNat.ofNat Nat (nat_lit 3) (instOfNatNat (nat_lit 3)))
