lhsN1_lt_one : ∀ (m : Nat),
  @LE.le Nat instLENat (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))) m →
    ∀ (T : Finset Nat),
      (∀ (t : Nat),
          @Membership.mem Nat (Finset Nat) (@SetLike.instMembership (Finset Nat) Nat (@Finset.instSetLike Nat)) T t →
            And (Not (@Dvd.dvd Nat Nat.instDvd (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))) t))
              (And (@LT.lt Nat instLTNat (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))) t)
                (@LE.le Nat instLENat
                  (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) (μ t)
                    (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))
                  m))) →
        @LT.lt Rat Rat.instLT (lhsN1 m T) (@OfNat.ofNat Rat (nat_lit 1) (@Rat.instOfNat (nat_lit 1)))
exists_not_badAt : ∀ (n : Nat),
  Not (@Dvd.dvd Nat Nat.instDvd (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))) n) →
    ∀ {ι : Type u_1} [inst : Fintype ι] [Nonempty ι] (e : ι → Nat),
      ∃ ε, ∀ (d : Nat), @Dvd.dvd Nat Nat.instDvd d n → Not (@BadAt ι inst e ε d)
exists_signs_odd : ∀ (n : Nat) [inst : @NeZero Nat (@MulZeroClass.toZero Nat Nat.instMulZeroClass) n],
  Not (@Dvd.dvd Nat Nat.instDvd (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))) n) →
    ∀ (w : ZMod n → Nat),
      (∃ x, @Ne Nat (w x) (@OfNat.ofNat Nat (nat_lit 0) (instOfNatNat (nat_lit 0)))) →
        ∃ u v,
          And (∀ (x : ZMod n), @Eq Nat (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat) (u x) (v x)) (w x))
            (∀ (d : Nat),
              @Dvd.dvd Nat Nat.instDvd d n →
                Not
                  (@Dvd.dvd (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                    (@semigroupDvd (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                      (@SemigroupWithZero.toSemigroup (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                        (@NonUnitalSemiring.toSemigroupWithZero (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                          (@AddMonoidAlgebra.nonUnitalSemiring Int Nat (@Ring.toSemiring Int Int.instRing)
                            Nat.instAddSemigroup))))
                    (@Polynomial.cyclotomic d Int Int.instRing)
                    (@HSub.hSub (@Polynomial Int Int.instSemiring) (@Polynomial Int Int.instSemiring)
                      (@Polynomial Int Int.instSemiring)
                      (@instHSub (@Polynomial Int Int.instSemiring)
                        (@SubNegMonoid.toSub (@Polynomial Int Int.instSemiring)
                          (@AddGroup.toSubNegMonoid (@Polynomial Int Int.instSemiring)
                            (@AddGroupWithOne.toAddGroup (@Polynomial Int Int.instSemiring)
                              (@Ring.toAddGroupWithOne (@Polynomial Int Int.instSemiring)
                                (@AddMonoidAlgebra.ring Int Nat Int.instRing Nat.instAddMonoid))))))
                      (@maskW n inst u) (@maskW n inst v))))
@exists_lift_two_all : ∀ {N : Nat} [inst : @NeZero Nat (@MulZeroClass.toZero Nat Nat.instMulZeroClass) N]
  (w : ZMod N → Nat),
  (∃ x, @Ne Nat (w x) (@OfNat.ofNat Nat (nat_lit 0) (instOfNatNat (nat_lit 0)))) →
    ∃ w',
      And
        (@Eq (ZMod N → Nat)
          (@Lift.reduce N (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))) inst Nat.fact_prime_two w') w)
        (∀ (d : Nat),
          @Dvd.dvd Nat Nat.instDvd d
              (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat) N
                (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) →
            Not (@Dvd.dvd Nat Nat.instDvd d N) →
              Not
                (@Dvd.dvd (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                  (@semigroupDvd (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                    (@SemigroupWithZero.toSemigroup (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                      (@NonUnitalSemiring.toSemigroupWithZero (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                        (@AddMonoidAlgebra.nonUnitalSemiring Int Nat (@Ring.toSemiring Int Int.instRing)
                          Nat.instAddSemigroup))))
                  (@Polynomial.cyclotomic d Int Int.instRing)
                  (@maskW
                    (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat) N
                      (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
                    ⋯ w')))
@sizes_eq_two_all : ∀ {N : Nat} [inst : @NeZero Nat (@MulZeroClass.toZero Nat Nat.instMulZeroClass) N] (P : Finset Nat),
  (∀ (d : Nat),
      @Membership.mem Nat (Finset Nat) (@SetLike.instMembership (Finset Nat) Nat (@Finset.instSetLike Nat)) P d →
        @Dvd.dvd Nat Nat.instDvd d N) →
    @Eq (Set Nat)
      (@Set.ofPred Nat fun s =>
        ∃ w',
          And (@Eq Nat (∑ y, w' y) s)
            (And (@LT.lt Nat instLTNat (@OfNat.ofNat Nat (nat_lit 0) (instOfNatNat (nat_lit 0))) s)
              (∀ (d : Nat),
                @Dvd.dvd Nat Nat.instDvd d
                    (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat) N
                      (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))) →
                  @Ne Nat d (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))) →
                    Iff
                      (@Dvd.dvd (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                        (@semigroupDvd (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                          (@SemigroupWithZero.toSemigroup (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                            (@NonUnitalSemiring.toSemigroupWithZero
                              (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                              (@AddMonoidAlgebra.nonUnitalSemiring Int Nat (@Ring.toSemiring Int Int.instRing)
                                Nat.instAddSemigroup))))
                        (@Polynomial.cyclotomic d Int Int.instRing)
                        (@maskW
                          (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat) N
                            (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))))
                          ⋯ w'))
                      (@Membership.mem Nat (Finset Nat)
                        (@SetLike.instMembership (Finset Nat) Nat (@Finset.instSetLike Nat)) P d))))
      (@Set.ofPred Nat fun s =>
        ∃ w,
          And (@Eq Nat (∑ x, w x) s)
            (And (@LT.lt Nat instLTNat (@OfNat.ofNat Nat (nat_lit 0) (instOfNatNat (nat_lit 0))) s)
              (∀ (d : Nat),
                @Dvd.dvd Nat Nat.instDvd d N →
                  @Ne Nat d (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))) →
                    Iff
                      (@Dvd.dvd (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                        (@semigroupDvd (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                          (@SemigroupWithZero.toSemigroup (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                            (@NonUnitalSemiring.toSemigroupWithZero
                              (@Polynomial Int (@Ring.toSemiring Int Int.instRing))
                              (@AddMonoidAlgebra.nonUnitalSemiring Int Nat (@Ring.toSemiring Int Int.instRing)
                                Nat.instAddSemigroup))))
                        (@Polynomial.cyclotomic d Int Int.instRing) (@maskW N inst w))
                      (@Membership.mem Nat (Finset Nat)
                        (@SetLike.instMembership (Finset Nat) Nat (@Finset.instSetLike Nat)) P d))))
