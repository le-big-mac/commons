                          d)))
                    (@HPow.hPow Nat Nat Nat (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid)))
                      (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))) (@Finset.card ι J)))
                  (@HPow.hPow Nat Nat Nat (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid)))
                    (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2))) (@Fintype.card ι inst))
@badAt_one_iff : ∀ {ι : Type u_1} [inst : Fintype ι] (e : ι → Nat) (ε : ι → Bool),
  Iff (@BadAt ι inst e ε (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))
    (@Eq Int (∑ k, sg (ε k)) (@OfNat.ofNat Int (nat_lit 0) (@instOfNat (nat_lit 0))))
@card_badSet_one : ∀ {ι : Type u_1} [inst : Fintype ι] (e : ι → Nat),
  @Eq Nat (@Finset.card (ι → Bool) (@badSet ι inst e (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))))
    (@ite Nat (@Even Nat instAddNat (@Fintype.card ι inst)) (@Fintype.card ι inst).instDecidablePredEven
      ((@Fintype.card ι inst).choose
        (@HDiv.hDiv Nat Nat Nat (@instHDiv Nat Nat.instDiv) (@Fintype.card ι inst)
          (@OfNat.ofNat Nat (nat_lit 2) (instOfNatNat (nat_lit 2)))))
      (@OfNat.ofNat Nat (nat_lit 0) (instOfNatNat (nat_lit 0))))
@rank_lt_card_image : ∀ {ι : Type u_1} [inst : Fintype ι] [Nonempty ι] (e : ι → Nat) {p : Nat},
  Nat.Prime p →
    ∀ (j : Nat),
      @LE.le Nat instLENat
        (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat)
          (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat)
