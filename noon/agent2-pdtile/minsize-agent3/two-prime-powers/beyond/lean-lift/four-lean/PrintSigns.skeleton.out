def Pnq.sg : Bool → ℤ :=
fun b => if b = true then 1 else -1
def Pnq.P.{u_1} : {ι : Type u_1} → [Fintype ι] → (ι → ℕ) → (ι → Bool) → Polynomial ℤ :=
fun {ι} [Fintype ι] e ε => ∑ k, Polynomial.C (sg (ε k)) * Polynomial.X ^ e k
def Pnq.BadAt.{u_1} : {ι : Type u_1} → [Fintype ι] → (ι → ℕ) → (ι → Bool) → ℕ → Prop :=
fun {ι} [Fintype ι] e ε d => Polynomial.cyclotomic d ℤ ∣ P e ε
def Pnq.badSet.{u_1} : {ι : Type u_1} → [Fintype ι] → (ι → ℕ) → ℕ → Finset (ι → Bool) :=
fun {ι} [Fintype ι] e d => {ε | BadAt e ε d}
def Pnq.classSum.{u_1} : {ι : Type u_1} → [Fintype ι] → (ι → ℕ) → (ι → Bool) → ℂ → ℕ → ℕ → ℂ :=
fun {ι} [Fintype ι] e ε η M r => ∑ k, if e k % M = r then ↑(sg (ε k)) * η ^ e k else 0
def Pnq.live.{u_1} : {ι : Type u_1} → [Fintype ι] → (ι → ℕ) → ℕ → ℕ → Bool :=
fun {ι} [Fintype ι] e p i => decide (∃ c < p ^ (i - 1), ∀ t < p, ∃ k, e k % p ^ i = c + t * p ^ (i - 1))
def Pnq.rank.{u_1} : {ι : Type u_1} → [Fintype ι] → (ι → ℕ) → ℕ → ℕ → ℕ :=
fun {ι} [Fintype ι] e p i => {j ∈ Finset.Icc 1 i | live e p j = true}.card
def Pnq.IsPivot.{u_1} : {ι : Type u_1} → (ι → ℕ) → ℕ → ℕ → Finset ι → Prop :=
fun {ι} e p i J =>
  (∀ k ∈ J, ∀ k' ∈ J, e k % p ^ i = e k' % p ^ i → k = k') ∧
    ∀ (c : ℕ), ∃ t < p, ∀ k ∈ J, e k % p ^ i ≠ c % p ^ (i - 1) + t * p ^ (i - 1)
def Pnq.μ : ℕ → ℕ :=
fun t => t.primeFactors.sup fun p => (p - 1) * t.factorization p
def Pnq.lhsN1 : ℕ → Finset ℕ → ℚ :=
fun m T =>
  (if Even m then ↑(m.choose (m / 2)) / 2 ^ m else 0) + ∑ t ∈ T, (1 / 2) ^ μ t -
    if Even m ∧ 3 ∈ T ∧ 14 ≤ m then 1 / 16 else 0
@classSum_eq_of_badAt : ∀ {ι : Type u_1} [inst : Fintype ι] (e : ι → Nat) (ε : ι → Bool) {p : Nat},
  Nat.Prime p →
    ∀ {i : Nat},
      @LE.le Nat instLENat (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))) i →
        ∀ {d : Nat},
          Not (@Dvd.dvd Nat Nat.instDvd p d) →
            ∀ {η : Complex},
              @IsPrimitiveRoot Complex (@CommRing.toCommMonoid Complex Complex.commRing) η d →
                @BadAt ι inst e ε
                    (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat)
                      (@HPow.hPow Nat Nat Nat (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid)))
                        p i)
                      d) →
                  ∀ (c t t' : Nat),
                    @LT.lt Nat instLTNat t p →
                      @LT.lt Nat instLTNat t' p →
                        @Eq Complex
                          (@classSum ι inst e ε η
                            (@HPow.hPow Nat Nat Nat
                              (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) p i)
                            (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat)
                              (@HMod.hMod Nat Nat Nat (@instHMod Nat Nat.instMod) c
                                (@HPow.hPow Nat Nat Nat
                                  (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) p
                                  (@HSub.hSub Nat Nat Nat (@instHSub Nat instSubNat) i
                                    (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))))
                              (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat) t
                                (@HPow.hPow Nat Nat Nat
                                  (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) p
                                  (@HSub.hSub Nat Nat Nat (@instHSub Nat instSubNat) i
                                    (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))))))
                          (@classSum ι inst e ε η
                            (@HPow.hPow Nat Nat Nat
                              (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) p i)
                            (@HAdd.hAdd Nat Nat Nat (@instHAdd Nat instAddNat)
                              (@HMod.hMod Nat Nat Nat (@instHMod Nat Nat.instMod) c
                                (@HPow.hPow Nat Nat Nat
                                  (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) p
                                  (@HSub.hSub Nat Nat Nat (@instHSub Nat instSubNat) i
                                    (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))))
                              (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat) t'
                                (@HPow.hPow Nat Nat Nat
                                  (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) p
                                  (@HSub.hSub Nat Nat Nat (@instHSub Nat instSubNat) i
                                    (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))))))))
@badAt_of_not_live : ∀ {ι : Type u_1} [inst : Fintype ι] (e : ι → Nat) (ε : ι → Bool) {p : Nat},
  Nat.Prime p →
    ∀ {i : Nat},
      @LE.le Nat instLENat (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))) i →
        ∀ {d : Nat},
          Not (@Dvd.dvd Nat Nat.instDvd p d) →
            @BadAt ι inst e ε
                (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat)
                  (@HPow.hPow Nat Nat Nat (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) p i)
                  d) →
              @Eq Bool (@live ι inst e p i) false →
                @BadAt ι inst e ε
                  (@HMul.hMul Nat Nat Nat (@instHMul Nat instMulNat)
                    (@HPow.hPow Nat Nat Nat (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) p
                      (@HSub.hSub Nat Nat Nat (@instHSub Nat instSubNat) i
                        (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1)))))
                    d)
@card_badSet_mul_two_pow_card_le : ∀ {ι : Type u_1} [inst : Fintype ι] (e : ι → Nat) {p : Nat},
  Nat.Prime p →
    ∀ {i : Nat},
      @LE.le Nat instLENat (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))) i →
        ∀ {d : Nat},
          Not (@Dvd.dvd Nat Nat.instDvd p d) →
