            (fun k =>
              @HMod.hMod Nat Nat Nat (@instHMod Nat Nat.instMod) (e k)
                (@HPow.hPow Nat Nat Nat (@instHPow Nat Nat (@NPow.toPow Nat (@Monoid.toNPow Nat Nat.instMonoid))) p j))
            (@Finset.univ ι inst)))
@exists_isPivot : ∀ {ι : Type u_1} [inst : Fintype ι] (e : ι → Nat) {p : Nat},
  Nat.Prime p →
    ∀ {i : Nat},
      @LE.le Nat instLENat (@OfNat.ofNat Nat (nat_lit 1) (instOfNatNat (nat_lit 1))) i →
        @Eq Bool (@live ι inst e p i) true →
          ∃ J,
