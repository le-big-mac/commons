import Pnq.SignFinal
/-! Audit: values of `Pnq.live`, `Pnq.rank`, `Pnq.μ`, `Pnq.lhsN1` (the definitions themselves; a family is
`fun k : Fin l.length => l.get k`).  Generated by `a2_gen.py`; compared with its expected values by `a2_cmp.py`. -/
open Pnq
def famOf (l : List ℕ) : Fin l.length → ℕ := fun k => l.get k
def rowOf (c : List ℕ × ℕ) : List ℕ :=
  ((List.range 5).map fun i => if live (famOf c.1) c.2 i then 1 else 0) ++
    ((List.range 5).map fun i => rank (famOf c.1) c.2 i)
def lhsOf (c : ℕ × List ℕ) : List ℤ := let q := lhsN1 c.1 c.2.toFinset; [q.num, (q.den : ℤ)]
