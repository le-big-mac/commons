@Polynomial.prod_cyclotomic_eq_X_pow_sub_one : ∀ {n : ℕ},
  0 < n → ∀ (R : Type u_1) [inst : CommRing R], ∏ i ∈ n.divisors, Polynomial.cyclotomic i R = Polynomial.X ^ n - 1
Polynomial.cyclotomic.monic : ∀ (n : ℕ) (R : Type u_1) [inst : Ring R], (Polynomial.cyclotomic n R).Monic
Polynomial.natDegree_cyclotomic : ∀ (n : ℕ) (R : Type u_1) [inst : Ring R] [Nontrivial R],
  (Polynomial.cyclotomic n R).natDegree = n.totient
Polynomial.cyclotomic_prime : ∀ (R : Type u_1) [inst : Ring R] (p : ℕ) [hp : Fact (Nat.Prime p)],
  Polynomial.cyclotomic p R = ∑ i ∈ Finset.range p, Polynomial.X ^ i
@Polynomial.cyclotomic_prime_pow_eq_geom_sum : ∀ {R : Type u_1} [inst : CommRing R] {p n : ℕ},
  Nat.Prime p → Polynomial.cyclotomic (p ^ (n + 1)) R = ∑ i ∈ Finset.range p, (Polynomial.X ^ p ^ n) ^ i
@Polynomial.isRoot_cyclotomic_iff : ∀ {R : Type u_1} [inst : CommRing R] {n : ℕ} [IsDomain R] [NeZero ↑n] {μ : R},
  (Polynomial.cyclotomic n R).IsRoot μ ↔ IsPrimitiveRoot μ n
