fun b =>
  @ite.{1} Int (@Eq.{1} Bool b Bool.true) (instDecidableEqBool b Bool.true)
    (@OfNat.ofNat.{0} Int (nat_lit 1) (@instOfNat (nat_lit 1)))
    (@Neg.neg.{0} Int Int.instNegInt (@OfNat.ofNat.{0} Int (nat_lit 1) (@instOfNat (nat_lit 1))))
