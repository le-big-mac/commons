def Pnq.sg : Bool → ℤ :=
fun b => if b = true then 1 else -1
def Pnq.P.{u_1} : {ι : Type u_1} → [Fintype ι] → (ι → ℕ) → (ι → Bool) → Polynomial ℤ :=
fun {ι} [Fintype ι] e ε => ∑ k, Polynomial.C (Pnq.sg (ε k)) * Polynomial.X ^ e k
def Pnq.BadAt.{u_1} : {ι : Type u_1} → [Fintype ι] → (ι → ℕ) → (ι → Bool) → ℕ → Prop :=
fun {ι} [Fintype ι] e ε d => Polynomial.cyclotomic d ℤ ∣ Pnq.P e ε
def Pnq.badSet.{u_1} : {ι : Type u_1} → [Fintype ι] → (ι → ℕ) → ℕ → Finset (ι → Bool) :=
fun {ι} [Fintype ι] e d => {ε | Pnq.BadAt e ε d}
def Pnq.classSum.{u_1} : {ι : Type u_1} → [Fintype ι] → (ι → ℕ) → (ι → Bool) → ℂ → ℕ → ℕ → ℂ :=
fun {ι} [Fintype ι] e ε η M r => ∑ k, if e k % M = r then ↑(Pnq.sg (ε k)) * η ^ e k else 0
def Pnq.live.{u_1} : {ι : Type u_1} → [Fintype ι] → (ι → ℕ) → ℕ → ℕ → Bool :=
fun {ι} [Fintype ι] e p i => decide (∃ c < p ^ (i - 1), ∀ t < p, ∃ k, e k % p ^ i = c + t * p ^ (i - 1))
def Pnq.rank.{u_1} : {ι : Type u_1} → [Fintype ι] → (ι → ℕ) → ℕ → ℕ → ℕ :=
fun {ι} [Fintype ι] e p i => {j ∈ Finset.Icc 1 i | Pnq.live e p j = true}.card
def Pnq.IsPivot.{u_1} : {ι : Type u_1} → (ι → ℕ) → ℕ → ℕ → Finset ι → Prop :=
fun {ι} e p i J =>
  (∀ k ∈ J, ∀ k' ∈ J, e k % p ^ i = e k' % p ^ i → k = k') ∧
    ∀ (c : ℕ), ∃ t < p, ∀ k ∈ J, e k % p ^ i ≠ c % p ^ (i - 1) + t * p ^ (i - 1)
def Pnq.μ : ℕ → ℕ :=
fun t => t.primeFactors.sup fun p => (p - 1) * t.factorization p
def Pnq.lhsN1 : ℕ → Finset ℕ → ℚ :=
fun m T =>
  (if Even m then ↑(m.choose (m / 2)) / 2 ^ m else 0) + ∑ t ∈ T, (1 / 2) ^ Pnq.μ t -
    if Even m ∧ 3 ∈ T ∧ 14 ≤ m then 1 / 16 else 0
@Pnq.classSum_eq_of_badAt : ∀ {ι : Type u_1} [inst : Fintype ι] (e : ι → ℕ) (ε : ι → Bool) {p : ℕ},
  Nat.Prime p →
    ∀ {i : ℕ},
      1 ≤ i →
        ∀ {d : ℕ},
          ¬p ∣ d →
            ∀ {η : ℂ},
              IsPrimitiveRoot η d →
                Pnq.BadAt e ε (p ^ i * d) →
                  ∀ (c t t' : ℕ),
                    t < p →
                      t' < p →
                        Pnq.classSum e ε η (p ^ i) (c % p ^ (i - 1) + t * p ^ (i - 1)) =
                          Pnq.classSum e ε η (p ^ i) (c % p ^ (i - 1) + t' * p ^ (i - 1))
@Pnq.badAt_of_not_live : ∀ {ι : Type u_1} [inst : Fintype ι] (e : ι → ℕ) (ε : ι → Bool) {p : ℕ},
  Nat.Prime p →
    ∀ {i : ℕ},
      1 ≤ i → ∀ {d : ℕ}, ¬p ∣ d → Pnq.BadAt e ε (p ^ i * d) → Pnq.live e p i = false → Pnq.BadAt e ε (p ^ (i - 1) * d)
@Pnq.card_badSet_mul_two_pow_card_le : ∀ {ι : Type u_1} [inst : Fintype ι] (e : ι → ℕ) {p : ℕ},
  Nat.Prime p →
    ∀ {i : ℕ},
      1 ≤ i →
        ∀ {d : ℕ},
          ¬p ∣ d →
            ∀ {J : Finset ι}, Pnq.IsPivot e p i J → (Pnq.badSet e (p ^ i * d)).card * 2 ^ J.card ≤ 2 ^ Fintype.card ι
@Pnq.badAt_one_iff : ∀ {ι : Type u_1} [inst : Fintype ι] (e : ι → ℕ) (ε : ι → Bool),
  Pnq.BadAt e ε 1 ↔ ∑ k, Pnq.sg (ε k) = 0
@Pnq.card_badSet_one : ∀ {ι : Type u_1} [inst : Fintype ι] (e : ι → ℕ),
  (Pnq.badSet e 1).card = if Even (Fintype.card ι) then (Fintype.card ι).choose (Fintype.card ι / 2) else 0
@Pnq.rank_lt_card_image : ∀ {ι : Type u_1} [inst : Fintype ι] [Nonempty ι] (e : ι → ℕ) {p : ℕ},
  Nat.Prime p → ∀ (j : ℕ), (p - 1) * Pnq.rank e p j + 1 ≤ (Finset.image (fun k => e k % p ^ j) Finset.univ).card
@Pnq.exists_isPivot : ∀ {ι : Type u_1} [inst : Fintype ι] (e : ι → ℕ) {p : ℕ},
  Nat.Prime p → ∀ {i : ℕ}, 1 ≤ i → Pnq.live e p i = true → ∃ J, Pnq.IsPivot e p i J ∧ (p - 1) * Pnq.rank e p i ≤ J.card
@Pnq.card_badSet_mul_two_pow_rank_le : ∀ {ι : Type u_1} [inst : Fintype ι] (e : ι → ℕ) {p : ℕ},
  Nat.Prime p →
    ∀ {i : ℕ},
      1 ≤ i →
        ∀ {d : ℕ},
          ¬p ∣ d →
            Pnq.live e p i = true →
              (Pnq.badSet e (p ^ i * d)).card * 2 ^ ((p - 1) * Pnq.rank e p i) ≤ 2 ^ Fintype.card ι
@Pnq.rank_lt_card : ∀ {ι : Type u_1} [inst : Fintype ι] [Nonempty ι] (e : ι → ℕ) {p : ℕ},
  Nat.Prime p → ∀ (i : ℕ), (p - 1) * Pnq.rank e p i + 1 ≤ Fintype.card ι
@Pnq.card_badSet_three_pow_mul_le : ∀ {ι : Type u_1} [inst : Fintype ι] (e : ι → ℕ),
  7 ≤ Fintype.card ι →
    ∀ {i : ℕ}, Pnq.live e 3 i = true → Pnq.rank e 3 i = 1 → (Pnq.badSet e (3 ^ i)).card * 16 ≤ 3 * 2 ^ Fintype.card ι
Pnq.lhsN1_lt_one : ∀ (m : ℕ), 1 ≤ m → ∀ (T : Finset ℕ), (∀ t ∈ T, ¬2 ∣ t ∧ 1 < t ∧ Pnq.μ t + 1 ≤ m) → Pnq.lhsN1 m T < 1
Pnq.exists_not_badAt : ∀ (n : ℕ),
  ¬2 ∣ n → ∀ {ι : Type u_1} [inst : Fintype ι] [Nonempty ι] (e : ι → ℕ), ∃ ε, ∀ (d : ℕ), d ∣ n → ¬Pnq.BadAt e ε d
Pnq.exists_signs_odd : ∀ (n : ℕ) [inst : NeZero n],
  ¬2 ∣ n →
    ∀ (w : ZMod n → ℕ),
      (∃ x, w x ≠ 0) →
        ∃ u v,
          (∀ (x : ZMod n), u x + v x = w x) ∧ ∀ (d : ℕ), d ∣ n → ¬Polynomial.cyclotomic d ℤ ∣ Pnq.maskW u - Pnq.maskW v
@Pnq.exists_lift_two_all : ∀ {N : ℕ} [inst : NeZero N] (w : ZMod N → ℕ),
  (∃ x, w x ≠ 0) →
    ∃ w', Pnq.Lift.reduce w' = w ∧ ∀ (d : ℕ), d ∣ N * 2 → ¬d ∣ N → ¬Polynomial.cyclotomic d ℤ ∣ Pnq.maskW w'
@Pnq.sizes_eq_two_all : ∀ {N : ℕ} [inst : NeZero N] (P : Finset ℕ),
  (∀ d ∈ P, d ∣ N) →
    {s |
        ∃ w',
          ∑ y, w' y = s ∧ 0 < s ∧ ∀ (d : ℕ), d ∣ N * 2 → d ≠ 1 → (Polynomial.cyclotomic d ℤ ∣ Pnq.maskW w' ↔ d ∈ P)} =
      {s | ∃ w, ∑ x, w x = s ∧ 0 < s ∧ ∀ (d : ℕ), d ∣ N → d ≠ 1 → (Polynomial.cyclotomic d ℤ ∣ Pnq.maskW w ↔ d ∈ P)}
@Pnq.mem_badSet : ∀ {ι : Type u_1} [inst : Fintype ι] (e : ι → ℕ) (d : ℕ) (ε : ι → Bool),
  ε ∈ Pnq.badSet e d ↔ Pnq.BadAt e ε d
@Pnq.live_iff : ∀ {ι : Type u_1} [inst : Fintype ι] (e : ι → ℕ) (p i : ℕ),
  Pnq.live e p i = true ↔ ∃ c < p ^ (i - 1), ∀ t < p, ∃ k, e k % p ^ i = c + t * p ^ (i - 1)
Pnq.Lift.exists_signs : ∀ (p q : ℕ) [inst : Fact (Nat.Prime p)] [inst_1 : Fact (Nat.Prime q)],
  p ≠ 2 →
    q ≠ 2 →
      p ≠ q →
        ∀ (a b : ℕ) (w : ZMod (p ^ a * q ^ b) → ℕ),
          (∃ x, w x ≠ 0) →
            ∃ u v,
              (∀ (x : ZMod (p ^ a * q ^ b)), u x + v x = w x) ∧
                ∀ (d : ℕ), d ∣ p ^ a * q ^ b → ¬Polynomial.cyclotomic d ℤ ∣ Pnq.maskW u - Pnq.maskW v
@Pnq.Lift.exists_lift_two : ∀ {N : ℕ} [inst : NeZero N] (p q : ℕ) [Fact (Nat.Prime p)] [Fact (Nat.Prime q)],
  p ≠ 2 →
    q ≠ 2 →
      p ≠ q →
        ∀ (k a b : ℕ),
          N = 2 ^ k * (p ^ a * q ^ b) →
            ∀ (w : ZMod N → ℕ),
              (∃ x, w x ≠ 0) →
                ∃ w', Pnq.Lift.reduce w' = w ∧ ∀ (d : ℕ), d ∣ N * 2 → ¬d ∣ N → ¬Polynomial.cyclotomic d ℤ ∣ Pnq.maskW w'
@Pnq.Lift.sizes_eq_two : ∀ {N : ℕ} [inst : NeZero N] (p q : ℕ) [Fact (Nat.Prime p)] [Fact (Nat.Prime q)],
  p ≠ 2 →
    q ≠ 2 →
      p ≠ q →
        ∀ (k a b : ℕ),
          N = 2 ^ k * (p ^ a * q ^ b) →
            ∀ (P : Finset ℕ),
              (∀ d ∈ P, d ∣ N) →
                {s |
                    ∃ w',
                      ∑ y, w' y = s ∧
                        0 < s ∧ ∀ (d : ℕ), d ∣ N * 2 → d ≠ 1 → (Polynomial.cyclotomic d ℤ ∣ Pnq.maskW w' ↔ d ∈ P)} =
                  {s |
                    ∃ w,
                      ∑ x, w x = s ∧
                        0 < s ∧ ∀ (d : ℕ), d ∣ N → d ≠ 1 → (Polynomial.cyclotomic d ℤ ∣ Pnq.maskW w ↔ d ∈ P)}
@Pnq.Lift.TwoAux.exists_lift_two_aux : ∀ {N : ℕ} [inst : NeZero N] (k N' : ℕ) [inst_1 : NeZero N'],
  N = 2 ^ k * N' →
    ¬2 ∣ N' →
      (∀ (B : ZMod N' → ℕ),
          (∃ z, B z ≠ 0) →
            ∃ u v,
              (∀ (z : ZMod N'), u z + v z = B z) ∧
                ∀ (e : ℕ), e ∣ N' → ¬Polynomial.cyclotomic e ℤ ∣ Pnq.maskW u - Pnq.maskW v) →
        ∀ (w : ZMod N → ℕ),
          (∃ x, w x ≠ 0) →
            ∃ w', Pnq.Lift.reduce w' = w ∧ ∀ (d : ℕ), d ∣ N * 2 → ¬d ∣ N → ¬Polynomial.cyclotomic d ℤ ∣ Pnq.maskW w'
