  [@NeZero Nat (@MulZeroClass.toZero Nat Nat.instMulZeroClass) M] → (ZMod M → Nat) → @Polynomial Int Int.instSemiring :=
fun {M} [@NeZero Nat (@MulZeroClass.toZero Nat Nat.instMulZeroClass) M] w =>
  ∑ a,
    @HMul.hMul (@Polynomial Int Int.instSemiring) (@Polynomial Int Int.instSemiring) (@Polynomial Int Int.instSemiring)
      (@instHMul (@Polynomial Int Int.instSemiring) (@AddMonoidAlgebra.instMul Int Nat Int.instSemiring instAddNat))
