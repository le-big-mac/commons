@Pnq.Lift.exists_lift_two : ∀ {N : ℕ} [inst : NeZero N] (p q : ℕ) [Fact (Nat.Prime p)] [Fact (Nat.Prime q)],
  p ≠ 2 →
    q ≠ 2 →
      p ≠ q →
        ∀ (k a b : ℕ),
          N = 2 ^ k * (p ^ a * q ^ b) →
            ∀ (w : ZMod N → ℕ),
              (∃ x, w x ≠ 0) →
                ∃ w', Pnq.Lift.reduce w' = w ∧ ∀ (d : ℕ), d ∣ N * 2 → ¬d ∣ N → ¬Polynomial.cyclotomic d ℤ ∣ Pnq.maskW w'
