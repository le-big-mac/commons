theorem instNeZeroNatHMul : ∀ {n m : ℕ} [hn : NeZero n] [hm : NeZero m], NeZero (n * m) :=
fun {n m} [hn : NeZero n] [hm : NeZero m] =>
  {
    out :=
      match n, hn, m, hm with
      | n.succ, x, n_1.succ, x_1 => fun h => nomatch h }
theorem Nat.instNeZeroHPow : ∀ {n m : ℕ} [NeZero n], NeZero (n ^ m) :=
fun {n m} [NeZero n] => { out := Nat.ne_zero_iff_zero_lt.mpr (Nat.pow_pos (Nat.pos_of_neZero n)) }
@NeZero.of_gt' : ∀ {α : Type u_1} {a : α} [inst : Zero α] [inst_1 : Preorder α] [IsBotZeroClass α] [inst_3 : One α]
  [Fact (1 < a)], NeZero a
Nat.Prime.one_lt' : ∀ (p : ℕ) [hp : Fact (Nat.Prime p)], Fact (1 < p)
theorem Pnq.instNeZeroNatHMulHPow_pnq : ∀ {p q n : ℕ} [Fact (Nat.Prime p)] [Fact (Nat.Prime q)], NeZero (p ^ n * q) :=
fun {p q n} [Fact (Nat.Prime p)] [Fact (Nat.Prime q)] =>
  { out := Nat.mul_ne_zero (pow_ne_zero n (Nat.Prime.ne_zero Fact.out)) (Nat.Prime.ne_zero Fact.out) }
class NeZero.{u_1} {R : Type u_1} [Zero R] (n : R) : Prop
number of parameters: 3
fields:
  NeZero.out : n ≠ 0
constructor:
