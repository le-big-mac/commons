@TwoAux.exists_lift_two_aux : ∀ {N : ℕ} [inst : NeZero N] (k N' : ℕ) [inst_1 : NeZero N'],
  N = 2 ^ k * N' →
    ¬2 ∣ N' →
      (∀ (B : ZMod N' → ℕ),
          (∃ z, B z ≠ 0) →
            ∃ u v,
              (∀ (z : ZMod N'), u z + v z = B z) ∧ ∀ (e : ℕ), e ∣ N' → ¬Polynomial.cyclotomic e ℤ ∣ maskW u - maskW v) →
        ∀ (w : ZMod N → ℕ),
          (∃ x, w x ≠ 0) → ∃ w', reduce w' = w ∧ ∀ (d : ℕ), d ∣ N * 2 → ¬d ∣ N → ¬Polynomial.cyclotomic d ℤ ∣ maskW w'
