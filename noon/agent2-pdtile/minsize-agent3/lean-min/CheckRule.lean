import Pnq.Rule
open Pnq

/-- kind 0: Φ_q ∤ A.  kind 1: Φ_q ∣ A and every level in F.  kind 2: Φ_q ∣ A, a0 the first level missing from F. -/
def ruleValue (kind p q a0 : ℕ) (Es Fs : Finset ℕ) : ℕ :=
  if kind = 0 then minU p q Es Fs else if kind = 1 then q * p ^ Es.card else minB p q Es Fs a0

