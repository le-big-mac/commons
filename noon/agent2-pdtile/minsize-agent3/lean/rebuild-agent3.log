== lake env lean CheckSharpStatements.lean:
@pow_card_union_le_size : ∀ {p q : ℕ},
  2 ≤ p → ∀ {n : ℕ} (t : Pnq.Tree p q n), ¬F t 0 → p ^ (eSet t ∪ fSet t).card ≤ size t
@sharp_lemma3 : ∀ {p q : ℕ},
  2 ≤ p →
    2 ≤ q →
      p.Coprime q →
        ∀ {n : ℕ} (t : Pnq.Tree p q n),
          ¬F t 0 → (fSet t \ eSet t).Nonempty → p ^ e t * (p ^ (fSet t \ eSet t).card + q) ≤ size t
pow_card_levels_le_card : ∀ (p q n : ℕ) [inst : Fact (Nat.Prime p)] [inst_1 : Fact (Nat.Prime q)],
  p ≠ q → ∀ (A : Finset (ZMod (p ^ n * q))), ¬Pqr.ZeroAt A q → p ^ (levelsE A ∪ levelsF A).card ≤ A.card
sharp_lemma3_zmod : ∀ (p q n : ℕ) [inst : Fact (Nat.Prime p)] [inst_1 : Fact (Nat.Prime q)],
  p ≠ q →
    ∀ (A : Finset (ZMod (p ^ n * q))),
      ¬Pqr.ZeroAt A q →
        (levelsF A \ levelsE A).Nonempty → p ^ (levelsE A).card * (p ^ (levelsF A \ levelsE A).card + q) ≤ A.card
