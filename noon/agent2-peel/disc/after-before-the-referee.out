   exactly n =  1000000, 1 wave:  0.8 and 0.3: 0.436 (0.013), 0.431;  0.9 and 0.5: 0.391 (0.011), 0.390;  0.6 and 0.2: 0.567 (0.013), 0.563;  0.5 and 0.4: 0.877 (0.003), 0.870
